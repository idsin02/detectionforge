/schema/rule_manifest.schema.json
{
  "$defs": {
    "Confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "RuleStatus": {
      "enum": [
        "experimental",
        "production",
        "deprecated"
      ],
      "title": "RuleStatus",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "TelemetryContract": {
      "additionalProperties": false,
      "description": "What telemetry the rule needs in order to fire at all.",
      "properties": {
        "source": {
          "description": "Telemetry source, e.g. 'sysmon', 'windows-security', 'mde'.",
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "event_ids": {
          "description": "Event IDs the rule consumes.",
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "minItems": 1,
          "title": "Event Ids",
          "type": "array"
        },
        "required_fields": {
          "description": "Flat field names that must be present in events.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Fields",
          "type": "array"
        }
      },
      "required": [
        "source",
        "event_ids",
        "required_fields"
      ],
      "title": "TelemetryContract",
      "type": "object"
    },
    "TestSpec": {
      "additionalProperties": false,
      "description": "One fixture file and the number of matches the rule must produce on it.",
      "properties": {
        "file": {
          "description": "Path relative to the rule dir, e.g. tests/positive_1.json",
          "title": "File",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/TestType"
        },
        "expected_matches": {
          "minimum": 0,
          "title": "Expected Matches",
          "type": "integer"
        }
      },
      "required": [
        "file",
        "type",
        "expected_matches"
      ],
      "title": "TestSpec",
      "type": "object"
    },
    "TestType": {
      "enum": [
        "positive",
        "negative"
      ],
      "title": "TestType",
      "type": "string"
    }
  },
  "$id": "https://github.com/idsin02/DetectionForge/rule_manifest",
  "additionalProperties": false,
  "description": "DetectionForge rule manifest (rule.yml). Cross-field rules are enforced by `dforge validate`, not by this schema.",
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "title": {
      "maxLength": 120,
      "minLength": 5,
      "title": "Title",
      "type": "string"
    },
    "version": {
      "description": "Semantic version, e.g. 1.2.0",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "title": "Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RuleStatus"
    },
    "author": {
      "minLength": 1,
      "title": "Author",
      "type": "string"
    },
    "created": {
      "format": "date",
      "title": "Created",
      "type": "string"
    },
    "modified": {
      "format": "date",
      "title": "Modified",
      "type": "string"
    },
    "attack": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Attack",
      "type": "array"
    },
    "telemetry_contract": {
      "$ref": "#/$defs/TelemetryContract"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "severity_rationale": {
      "minLength": 10,
      "title": "Severity Rationale",
      "type": "string"
    },
    "confidence": {
      "$ref": "#/$defs/Confidence"
    },
    "confidence_rationale": {
      "minLength": 10,
      "title": "Confidence Rationale",
      "type": "string"
    },
    "known_false_positives": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Known False Positives",
      "type": "array"
    },
    "blind_spots": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Blind Spots",
      "type": "array"
    },
    "tuning_notes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Tuning Notes",
      "type": "array"
    },
    "references": {
      "items": {
        "format": "uri",
        "maxLength": 2083,
        "minLength": 1,
        "type": "string"
      },
      "title": "References",
      "type": "array"
    },
    "tests": {
      "items": {
        "$ref": "#/$defs/TestSpec"
      },
      "title": "Tests",
      "type": "array"
    },
    "deprecated_by": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deprecated By"
    }
  },
  "required": [
    "id",
    "title",
    "version",
    "status",
    "author",
    "created",
    "modified",
    "attack",
    "telemetry_contract",
    "severity",
    "severity_rationale",
    "confidence",
    "confidence_rationale",
    "known_false_positives",
    "blind_spots",
    "tuning_notes",
    "references",
    "tests"
  ],
  "title": "DetectionForge Rule Manifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}